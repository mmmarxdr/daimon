# Binaries for programs and plugins
/daimon
/server
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
build/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
cover.out

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Environment files
.env
.env.local
.env.*

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Developer-only scripts (not for contributors)
dev.sh

# Personal config with real API keys — use configs/default.yaml.example as template
configs/default.yaml

# Generated TDD docs from sub-agents
TDD_EVIDENCE_*.md

# Embedded frontend (copied from daimon-frontend)
internal/web/static/assets/
!internal/web/static/index.html

# GoReleaser snapshot output
dist/

# CodeGraph index (regenerated locally per machine)
.codegraph/

# Skill registry cache (fingerprint regenerated by sdd-init)
.atl/.skill-registry.cache.json

# Daimon TUI design bundle — keep readable source (README, chats, jsx, html),
# ignore the heavy binaries (tarball + raster assets)
docs/tui-design/daimon-tui-design.tar.gz
docs/tui-design/daimon/project/uploads/
docs/tui-design/daimon/project/scraps/

